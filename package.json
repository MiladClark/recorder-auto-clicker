{
  "name": "framecue",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "build:app": "node scripts/build-app.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "tauri dev",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "node tests/browser.mjs",
    "test:select": "node tests/select-browser.mjs",
    "test:theme": "node tests/theme-browser.mjs",
    "test:voice": "node tests/voice-browser.mjs",
    "test:desktop": "node tests/desktop.mjs && node tests/clicker-native.mjs",
    "brand:generate": "node scripts/brand.mjs",
    "test:clicker": "node tests/clicker-browser.mjs",
    "test:clicker:native": "node tests/clicker-native.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.3",
    "@tailwindcss/vite": "^4.1.3",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.1"
  }
}
